# Normalize line endings: keep the repository LF on every platform
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.task binary
*.png  binary
*.jpg  binary
*.gif  binary
*.mp4  binary
*.zip  binary
